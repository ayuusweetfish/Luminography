CONFIG_AUTOBOOT=y
CONFIG_BOOTDELAY=1
CONFIG_ENV_IS_NOWHERE=y
CONFIG_BOOTCOMMAND="sf probe 0:0 80000000; sf read 0x80C00000 0x80000 0x4000; sf read 0x80008000 0x90000 0x500000; bootz 0x80008000 - 0x80C00000"

CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH=y
CONFIG_SPI_FLASH_SMART_HWCAPS=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_SPL_SPI_FLASH_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_SPI_FLASH_MTD=y
