diff --git a/sun4i_orig/sun4i_backend.c b/sun4i/sun4i_backend.c
index db74db6..b25c889 100644
--- a/sun4i_orig/sun4i_backend.c
+++ b/sun4i/sun4i_backend.c
@@ -737,25 +737,37 @@ static struct sun4i_frontend *sun4i_backend_find_frontend(struct sun4i_drv *drv,
 	struct sun4i_frontend *frontend;
 
 	port = of_graph_get_port_by_id(node, 0);
-	if (!port)
+	if (!port) {
+		printk(KERN_WARNING "Port not found?\n");
 		return ERR_PTR(-EINVAL);
-
+	}
+	
+	printk(KERN_WARNING "Port %pOF\n", port);
 	for_each_available_child_of_node(port, ep) {
 		remote = of_graph_get_remote_port_parent(ep);
 		if (!remote)
 			continue;
-		of_node_put(remote);
+
+		printk(KERN_WARNING "Remote %pOF\n", remote);
+		if (!of_device_is_available(remote)) {
+			printk(KERN_WARNING "Remote is not available\n");
+		}
 
 		/* does this node match any registered engines? */
 		list_for_each_entry(frontend, &drv->frontend_list, list) {
+			printk(KERN_WARNING " > Frontend %pOF\n", frontend->node);
 			if (remote == frontend->node) {
 				of_node_put(port);
 				of_node_put(ep);
+				of_node_put(remote);
 				return frontend;
 			}
 		}
+
+		of_node_put(remote);
 	}
 	of_node_put(port);
+	printk(KERN_WARNING "Not found > <\n");
 	return ERR_PTR(-EINVAL);
 }
 
@@ -780,6 +792,7 @@ static const struct regmap_config sun4i_backend_regmap_config = {
 static int sun4i_backend_bind(struct device *dev, struct device *master,
 			      void *data)
 {
+	dev_warn(dev, "sun4i_backend_bind\n");
 	struct platform_device *pdev = to_platform_device(dev);
 	struct drm_device *drm = data;
 	struct sun4i_drv *drv = drm->dev_private;
@@ -964,6 +977,7 @@ static const struct component_ops sun4i_backend_ops = {
 
 static int sun4i_backend_probe(struct platform_device *pdev)
 {
+	printk(KERN_WARNING "sun4i_backend_probe\n");
 	return component_add(&pdev->dev, &sun4i_backend_ops);
 }
 
